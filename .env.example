# Resend API key for sending "Talk to Us" consultation email notifications.
# Get one free at https://resend.com/api-keys (after signing up).
RESEND_API_KEY=

# Email address that receives new consultation requests.
CONSULTATION_NOTIFY_EMAIL=konsulinsupport@gmail.com

# Sender identity shown on outgoing notification emails.
# Resend's shared sandbox sender works for testing without domain setup;
# verify your own domain in the Resend dashboard for production, then
# change this to something like "Konsulin <notifikasi@konsulin.id>".
RESEND_FROM_EMAIL=Konsulin <onboarding@resend.dev>

# Alamat API Makalin Ops (sistem rekrutmen internal) buat form lamaran di /karir. Server landing yang nerusin
# kiriman ke sini - browser pelamar nggak pernah nyentuh alamat ini. Makalin jalan di VPS yang sama (port 4100).
MAKALIN_API_URL=http://127.0.0.1:4100
